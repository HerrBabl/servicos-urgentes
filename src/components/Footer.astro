---
import { cityHomepageContext } from '../data/cities.ts';

// Same city-aware fix as Header.astro (commit f777927): on any page under a
// known city path, service links point to that city's real aggregation page
// instead of always defaulting to SJC's hubs. Falls through safely to the
// existing SJC hrefs everywhere else — zero behavior change except /jacarei/*.
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const currentCitySlug = pathSegments[0];
const isOnCityPage = currentCitySlug in cityHomepageContext;
---

<footer class="bg-gray-900 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Company Info -->
      <div class="col-span-1 md:col-span-2">
        <div class="flex items-center mb-4">
          <span class="text-2xl font-bold text-red-500">🚨 Serviços Urgentes</span>
        </div>
        <p class="text-gray-300 mb-4">
          Conectamos você aos melhores profissionais de emergência em São José dos Campos e região. 
          Disponível 24 horas por dia, 7 dias por semana.
        </p>
        {/* These links were href="#" placeholders; they now point to the real profiles, tying the site to them. No public WhatsApp number exists, so that icon was removed. */}
        <div class="flex space-x-4">
          <a href="https://www.facebook.com/profile.php?id=61582980766438" target="_blank" rel="noopener noreferrer" aria-label="Facebook do Serviços Urgentes" class="inline-flex items-center justify-center min-w-[44px] min-h-[44px] text-gray-400 hover:text-white transition-colors">
            📘
          </a>
          <a href="https://www.instagram.com/servicosurgentessjc/" target="_blank" rel="noopener noreferrer" aria-label="Instagram do Serviços Urgentes" class="inline-flex items-center justify-center min-w-[44px] min-h-[44px] text-gray-400 hover:text-white transition-colors">
            📷
          </a>
          <a href="https://www.linkedin.com/company/servi%C3%A7os-urgentes/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn do Serviços Urgentes" class="inline-flex items-center justify-center min-w-[44px] min-h-[44px] text-gray-400 hover:text-white transition-colors">
            💼
          </a>
        </div>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-lg font-semibold mb-4">Serviços</h3>
        <ul class="space-y-2">
          <li><a href={isOnCityPage ? `/servicos/encanador/${currentCitySlug}/` : '/servicos/encanador/'} class="text-gray-300 hover:text-white transition-colors">Encanador 24h</a></li>
          <li><a href={isOnCityPage ? `/servicos/chaveiro/${currentCitySlug}/` : '/servicos/chaveiro/'} class="text-gray-300 hover:text-white transition-colors">Chaveiro 24h</a></li>
          <li><a href={isOnCityPage ? `/servicos/eletricista/${currentCitySlug}/` : '/servicos/eletricista/'} class="text-gray-300 hover:text-white transition-colors">Eletricista 24h</a></li>
          <li><a href={isOnCityPage ? `/servicos/ar-condicionado/${currentCitySlug}/` : '/servicos/ar-condicionado/'} class="text-gray-300 hover:text-white transition-colors">Ar Condicionado 24h</a></li>
          <li><a href={isOnCityPage ? `/servicos/marido-de-aluguel/${currentCitySlug}/` : '/servicos/marido-de-aluguel/'} class="text-gray-300 hover:text-white transition-colors">🛠️ Marido de Aluguel</a></li>
        </ul>
      </div>

   <!-- Quick Links -->
      <div>
        <h3 class="text-lg font-semibold mb-4">Links Rápidos</h3>
        <ul class="space-y-2">
          <li><a href="/bairros/" class="text-gray-300 hover:text-white transition-colors">Bairros Cobertos</a></li>
          <li><a href="/cadastro/" class="text-gray-300 hover:text-white transition-colors">Cadastre sua Empresa</a></li>
          <li><a href="/blog/" class="text-gray-300 hover:text-white transition-colors">Blog e Dicas</a></li>
          <li><a href="/#servicos" class="text-gray-300 hover:text-white transition-colors">Como Funciona</a></li>
          <li><a href="/politica-de-privacidade/" class="text-gray-300 hover:text-white transition-colors">Política de Privacidade</a></li>
        </ul>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-8 pt-8 border-t border-gray-800 text-center">
      <p class="text-gray-400">
        © 2026 Serviços Urgentes. Todos os direitos reservados. 
        São José dos Campos, SP - Brasil
      </p>
    </div>
  </div>
</footer>