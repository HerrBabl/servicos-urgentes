---
// Links from a service's SJC hub to the same service in every other city. Built from
// cityHomepageContext and serviceContext, so a new city or service needs no edit here.
import { cityHomepageContext } from '../data/cities.ts';
import { serviceContext } from '../data/services.ts';

export interface Props {
  service: string;
}

const { service } = Astro.props;
const svc = serviceContext[service];
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
  <h2 class="text-xl font-bold text-gray-900 mb-4">{svc.displayNamePlural} em outras cidades do Vale do Paraíba</h2>
  <div class="flex flex-wrap gap-3">
    {Object.entries(cityHomepageContext).map(([citySlug, ctx]) => (
      <a
        href={`/servicos/${service}/${citySlug}/`}
        class="bg-white border border-gray-200 rounded-lg px-4 py-2 text-sm text-gray-700 hover:text-red-600 hover:border-red-400 transition-colors font-medium"
      >
        <span aria-hidden="true">{svc.icon}</span> {svc.displayNamePlural} em {ctx.displayName}
      </a>
    ))}
  </div>
</section>
