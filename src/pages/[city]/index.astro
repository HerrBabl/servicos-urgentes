---
// src/pages/[city]/index.astro
//
// City hub page — first instance of a reusable /[city]/ pattern for future
// Vale do Paraíba expansion. Only 'jacarei' gets a real route today; SJC's
// existing homepage (src/pages/index.astro) stays separate and untouched —
// getStaticPaths() below deliberately does not generate a route for it.
//
// Route-collision check (2026-08-31): confirmed safe. Astro always prioritizes
// static path segments over dynamic ones, and this is fully static output
// (SSG) — getStaticPaths() only returns 'jacarei', so the only file this
// produces is dist/jacarei/index.html. No existing top-level route is named
// 'jacarei', so there's no collision today. Future city additions must avoid
// reusing an existing static route name (sobre, servicos, blog, emergencias,
// bairros, locais, cadastro, politica-de-privacidade) as a city slug.

import Layout from '../../layouts/Layout.astro';
import { neighborhoodContext } from '../../data/neighborhoods.ts';

// cityHomepageContext lives in its own module — a route file that also exports
// getStaticPaths() cannot export a second top-level const without breaking
// Astro's esbuild parse pass. Also needed by the new
// src/pages/servicos/[service]/[city]/index.astro route.
import { cityHomepageContext } from '../../data/cities.ts';

// Fixed 5-service list for the grid — mirrors the same hardcoded set already
// used in src/pages/index.astro's service grid (no shared/exported source
// exists for this on the site today, so this follows the existing pattern
// rather than introducing a new one).
const services = [
  { slug: 'encanador',         name: 'Encanador',                 icon: '💧', color: 'blue'   },
  { slug: 'eletricista',       name: 'Eletricista',                icon: '⚡', color: 'yellow' },
  { slug: 'chaveiro',          name: 'Chaveiro',                   icon: '🔑', color: 'orange' },
  { slug: 'ar-condicionado',   name: 'Ar-Condicionado',            icon: '❄️', color: 'cyan'   },
  { slug: 'marido-de-aluguel', name: 'Marido de Aluguel',          icon: '🛠️', color: 'green'  },
];

export function getStaticPaths() {
  return [
    { params: { city: 'jacarei' } },
  ];
}

const { city } = Astro.params;
// safe: getStaticPaths() guarantees city is always a valid key — no guard needed
const ctx = cityHomepageContext[city as string];

// Bairro list derived at build time — never hardcoded — by filtering the
// shared neighborhoodContext for this city.
const bairros = Object.entries(neighborhoodContext)
  .filter(([, data]) => data.city === ctx.displayName)
  .map(([slug, data]) => ({
    slug,
    displayName: data.displayName,
    region: data.region,
  }));

// Page-level schema, built from `city`/`ctx` rather than a hardcoded 'Jacareí'
// string, so this is structurally ready for future cities even though only
// jacarei renders today. Layout.astro's sitewide Organization schema already
// lists Jacareí in areaServed unconditionally — this is additional, page-level
// context, not a fix to anything missing there.
const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": ctx.metaTitle,
      "description": ctx.metaDescription,
      "url": ctx.canonicalURL,
      "about": {
        "@type": "City",
        "name": ctx.displayName,
        "addressRegion": "SP",
        "addressCountry": "BR",
      },
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Início",
          "item": "https://servicosurgentes.com",
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": ctx.displayName,
          "item": ctx.canonicalURL,
        },
      ],
    },
  ],
};

const heroBorder: Record<string, string> = {
  blue: 'border-blue-600', yellow: 'border-yellow-500', orange: 'border-orange-500',
  cyan: 'border-cyan-500', green: 'border-green-600',
};
---
<Layout title={ctx.metaTitle} description={ctx.metaDescription} canonicalURL={ctx.canonicalURL}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(pageSchema)} />

  <!-- 1. Hero -->
  <section class="relative overflow-hidden bg-gradient-to-br from-red-600 via-red-700 to-red-800 py-20 md:py-28">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-red-100 font-semibold uppercase tracking-wide mb-3">{ctx.displayName}, SP</p>
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">{ctx.heroHeadline}</h1>
      <p class="text-xl text-red-100 max-w-2xl mx-auto">{ctx.heroSubhead}</p>
    </div>
  </section>

  <!-- 2. Service grid -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-12 text-center">
        Escolha o Serviço
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-4">
        {services.map(svc => (
          <a
            href={`/servicos/${svc.slug}/jacarei/`}
            class={`bg-white rounded-lg shadow-lg p-6 border-b-4 ${heroBorder[svc.color]} hover:-translate-y-1 transition-all text-center group`}
          >
            <div class="text-3xl mb-2 group-hover:scale-110 transition-transform" aria-hidden="true">{svc.icon}</div>
            <div class="font-bold text-gray-900 text-base">{svc.name}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Bairros atendidos -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-12 text-center">
        Bairros Atendidos em {ctx.displayName}
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {bairros.map(bairro => (
          <a
            href={`/bairros/${bairro.slug}/`}
            class="bg-white rounded-xl border border-gray-200 p-6 hover:border-red-400 hover:shadow-md transition-all group"
          >
            <div class="font-bold text-gray-900 text-lg group-hover:text-red-600 transition-colors">{bairro.displayName}</div>
            <div class="text-sm text-gray-500 mt-1">{bairro.region}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Trust signals — reused near-verbatim from src/pages/index.astro:249-292.
       Content confirmed city-agnostic (no SJC-specific wording or bairro
       examples) before reuse. -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Como Usar o Site
        </h2>
        <p class="text-xl text-gray-600">
          Encontre profissionais qualificados na sua região
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="bg-red-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl">🔍</span>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">1. Busque o Serviço</h3>
          <p class="text-gray-600">
            Navegue pelas categorias ou use a busca para encontrar o tipo de profissional que precisa
          </p>
        </div>

        <div class="text-center">
          <div class="bg-red-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl">📋</span>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">2. Compare e Escolha</h3>
          <p class="text-gray-600">
            Veja informações, avaliações e área de atendimento. <strong>Você decide qual profissional contratar</strong> - não há intermediação.
          </p>
        </div>

        <div class="text-center">
          <div class="bg-red-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl">📞</span>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">3. Entre em Contato</h3>
          <p class="text-gray-600">
            Contate diretamente o profissional escolhido usando as informações fornecidas
          </p>
        </div>
      </div>
    </div>
  </section>

</Layout>
