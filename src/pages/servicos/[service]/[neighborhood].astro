        { label: 'Instalação de split (mão de obra)', range: 'R$ 300 – R$ 500' },
        { label: 'Diagnóstico + reparo geral',         range: 'R$ 150 – R$ 400' },
      ],
      relatedBlogSlug: '/blog/ar-condicionado-nao-gela-sjc/',
