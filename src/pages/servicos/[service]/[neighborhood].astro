// src/pages/servicos/[service]/[neighborhood].astro
//
// ── PHASE 2B MERGE — PRODUCTION FILE ────────────────────────────────────────
// Generates 120 static pages: 5 services × 24 neighborhoods (as of Aug 12, 2026)
// Neighborhood count grows via the "depth-first" SJC expansion track — each
// new entry here must also have a matching /bairros/[slug]/ page, or internal
// cross-links from that neighborhood will 404. As of this count, every slug
// referenced in a nearbyNeighborhoods array below has its own context entry
// and /bairros/ page — no orphan references remain. Verify this stays true
// with the grep/count check in content-rules.md Section 7 before adding the
// next entry (see LOCAL_DOMINATION_BLUEPRINT + handoff notes).
//
// SOURCES MERGED:
//   NEBULA  → Layout.astro wrapper, BusinessListing component, local .js data
//             files, city-wide provider display, 24-neighborhood cross-link grid
//   CLAUDE  → Rich neighborhood + service context objects, FAQPage schema,
//             dynamic SEO metadata, Crisis Psychology page structure,
//             faqTemplate() per service+neighborhood combo
//
// STRATEGY: Crisis Psychology Framework
//   Stage 1 — AWARENESS   → Hero: validate the emergency is real
//   Stage 2 — ACTION      → Numbered steps: what to do right now
//   Stage 3 — ADAPTATION  → Prevention: how to avoid next time
//   Stage 4 — ADVOCACY    → Final CTA: close the conversion
//
// SEO GOAL: Rank for "[service] em [bairro] sjc" — low-competition combos
//           FAQPage schema cited by Perplexity/ChatGPT/SGE as authority
// CONVERSION GOAL: Click-to-call above fold on mobile, zero friction

import Layout from '../../../layouts/Layout.astro';
import BusinessListing from '../../../components/BusinessListing.astro';

// ── LOCAL DATA IMPORTS (city-wide, not filtered per neighborhood) ─────────────
// Nebula decision: Supabase isn't neighborhood-tagged yet at launch.
// Using all providers per service type = full listings, zero empty pages.
import { ar_condicionado } from '../../../data/ar_condicionado.js';
import { chaveiros }       from '../../../data/chaveiros.js';
import { eletricistas }    from '../../../data/eletricistas.js';
import { encanadores }     from '../../../data/encanadores.js';
import { maridos }         from '../../../data/maridos.js';

// neighborhoodContext lives in its own module — a route file that also exports
// getStaticPaths() cannot export a second top-level const without breaking
// Astro's esbuild parse pass (confirmed via isolated build test, Aug 31, 2026).
// It also needs to be importable from src/pages/[city]/index.astro.
import { neighborhoodContext } from '../../../data/neighborhoods.ts';

// ── ENV: Supabase credentials (ready for future per-neighborhood filtering) ───
// NEVER hardcode credentials. RLS must be active on all tables before enabling.
// To activate Supabase filtering: uncomment the import + swap provider source below.
// const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
// const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

// ══════════════════════════════════════════════════════════════════════════════
// SERVICE CONTEXT DATA
// WHY: Dynamic content per service = unique page per combo, avoids thin/doorway flag
// SEO: faqTemplate() generates 5 natural-language Q&As per page for FAQPage schema
//      whatToDo[] and prevention[] provide 400+ words of unique editorial content
// SAFETY: Electrical & gas whatToDo[] NEVER gives DIY repair steps — always redirects
//         to professional or Bombeiros (193). Project instruction — non-negotiable.
// ══════════════════════════════════════════════════════════════════════════════
