    },
  },
  'Jacareí': {
    // Intentionally empty — no verified Jacareí pricing data exists yet, and no
    // Jacareí-specific blog content. Price list and blog cross-link render
    // conditionally (commit 2). Backfill priceItems here when provider-sourced
    // pricing is collected. Empty objects are deliberate, not an oversight.
    'encanador': {}, 'eletricista': {}, 'chaveiro': {},
    'ar-condicionado': {}, 'marido-de-aluguel': {},
