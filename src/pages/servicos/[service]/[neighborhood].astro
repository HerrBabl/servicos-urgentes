        { label: 'Abertura de porta (sem dano)',        range: 'R$ 80 – R$ 180' },
        { label: 'Abertura de fechadura de alta seg.',  range: 'R$ 200 – R$ 400' },
        { label: 'Cópia de chave comum',                range: 'R$ 10 – R$ 30' },
        { label: 'Cópia de chave codificada',           range: 'R$ 80 – R$ 200' },
        { label: 'Instalação de fechadura eletrônica',  range: 'R$ 200 – R$ 500 (+peça)' },
