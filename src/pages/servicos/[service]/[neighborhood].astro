    heroKeyword: 'Marido de Aluguel',
  },
};

// ══════════════════════════════════════════════════════════════════════════════
// CITY CONTEXT SCAFFOLDING (structural only — not yet consumed by render logic)
// WHY: Step 1 of the serviceContext city-overlay refactor. Adds shared-base +
// per-city-per-service data alongside the existing serviceContext, without
// touching serviceContext or any render logic. No behavior change in this
// commit — cityContext/cityServiceContext are unused until a later commit
// wires them into the template.
// ══════════════════════════════════════════════════════════════════════════════
const cityContext: Record<string, {
  rainySeason: string;
  rainySeasonStart: string;
}> = {
  'São José dos Campos': { rainySeason: 'outubro–março', rainySeasonStart: 'outubro' },
  'Jacareí':             { rainySeason: 'outubro–março', rainySeasonStart: 'outubro' },
};

const cityServiceContext: Record<string, Record<string, {
  priceItems?: { label: string; range: string }[];
  relatedBlogSlug?: string;
  relatedBlogTitle?: string;
}>> = {
  'São José dos Campos': {
    'encanador': {
      priceItems: [
        { label: 'Visita técnica simples',              range: 'R$ 80 – R$ 150' },
        { label: 'Desentupimento (pia/vaso)',            range: 'R$ 150 – R$ 300' },
        { label: 'Caça-vazamento eletrônico (geofone)', range: 'R$ 350 – R$ 600' },
        { label: 'Troca de registro ou flexível',        range: 'R$ 120 – R$ 250 (+peça)' },
        { label: 'Limpeza de caixa d\'água',             range: 'R$ 200 – R$ 400' },
      ],
