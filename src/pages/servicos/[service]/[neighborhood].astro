    },
    'marido-de-aluguel': {
      priceItems: [
        { label: 'Hora trabalhada (mín. 2h)',      range: 'R$ 80 – R$ 150/hora' },
        { label: 'Instalação de suporte de TV',    range: 'R$ 150 – R$ 250' },
        { label: 'Montagem de móveis',             range: 'R$ 200 – R$ 400' },
        { label: 'Troca de torneira ou registro',  range: 'R$ 80 – R$ 180 (+peça)' },
        { label: 'Pequenos reparos hidráulicos',   range: 'R$ 120 – R$ 250' },
      ],
